# === CLOUD DEPLOY: Railway (backend) + Vercel (frontend) + Supabase (leaderboard) ===
# Do NOT set LOCAL_INSTANCE_MODE — everyone shares one server simulation.

ENVIRONMENT=production
DEBUG=false
AUTO_INIT_DB=false

# Railway Postgres (add Postgres plugin in Railway dashboard)
DATABASE_URL=postgresql+psycopg://...

JWT_SECRET=generate-a-long-random-string
ADMIN_SECRET=your-admin-secret-for-event-day

# Your Vercel URL (set after first deploy)
CORS_ORIGINS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-backend.up.railway.app

# Supabase — backend pushes all trader scores every ~45s
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_LEADERBOARD_TABLE=participant_snapshots
LEADERBOARD_SYNC_INTERVAL_SEC=45

SIMULATION_SPEED=1
DEFAULT_STARTING_CAPITAL=500000

# --- Set these on VERCEL (frontend project settings) ---
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://your-backend.up.railway.app
# NEXT_PUBLIC_API_PREFIX=/api/v1
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_LEADERBOARD_TABLE=participant_snapshots
# Do NOT set NEXT_PUBLIC_LOCAL_INSTANCE on cloud deploy
